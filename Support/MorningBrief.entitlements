<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Lets the daily notification use the .timeSensitive interruption level, so it
	  breaks through Focus and scheduled-summary delivery. If signing complains
	  that your team cannot add this capability, delete this file and clear
	  CODE_SIGN_ENTITLEMENTS — the notification then arrives at the .active level
	  instead, which still plays the spoken sound.
	-->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
